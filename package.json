{
  "name": "oree-company-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "discovery:generate": "node --experimental-strip-types scripts/generate-discovery-files.ts",
    "index:assistant": "node scripts/generate-assistant-index.mjs",
    "brand:optimize": "node scripts/optimize-brand-assets.mjs",
    "images:optimize": "node --experimental-strip-types scripts/optimize-images.ts",
    "predev": "npm run discovery:generate && npm run index:assistant",
    "dev": "node scripts/start-dev.mjs",
    "build": "npm run discovery:generate && npm run index:assistant && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "crawlability:check": "node scripts/crawlability-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build:visual": "npm run index:assistant && tsc -b && vite build --config vite.visual.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.11"
  }
}