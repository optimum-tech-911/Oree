    "file": "docs/PRODUCT_BLUEPRINT.md"
  },
  {
    "id": "docs/PRODUCT_BLUEPRINT.md:1522",
    "text": "salarié qui prépare une transition ;",
    "file": "docs/PRODUCT_BLUEPRINT.md"
  },
